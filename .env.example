# ============================================================
# IceStream — environment configuration template
# Copy this file to `.env` and adjust values as needed.
# Never commit the real `.env` file (it is git-ignored).
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=icestream
POSTGRES_USER=icestream
POSTGRES_PASSWORD=icestream_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:29092

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=icestream_minio
MINIO_SECRET_KEY=icestream_minio_secret
MINIO_BUCKET=icestream-warehouse

# --- FastAPI ---
APP_ENV=development
APP_NAME=IceStream API
APP_VERSION=0.1.0
DEBUG=true

# --- Frontend ---
VITE_API_URL=http://localhost:8000
