# Copy this file to .env and adjust if needed:
#   cp .env.example .env
#
# This single .env is read by both docker-compose (for Postgres) and the
# FastAPI backend (via backend/config.py), so values must stay consistent.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=icestream
DB_USER=icestream
DB_PASSWORD=icestream

# --- App ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
