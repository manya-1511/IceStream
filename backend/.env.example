# FastAPI
APP_ENV=development
APP_NAME=IceStream API
APP_VERSION=0.1.0
DEBUG=true

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=icestream
POSTGRES_USER=icestream
POSTGRES_PASSWORD=icestream_dev_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=icestream_minio
MINIO_SECRET_KEY=icestream_minio_secret
MINIO_BUCKET=icestream-warehouse
MINIO_USE_SSL=false
