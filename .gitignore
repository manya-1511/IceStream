# Environment
.env
*.env
!.env.example

# Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
*.egg-info/

# Node / frontend
node_modules/
dist/
build/
.vite/

# Data (keep structure and docs, ignore actual downloaded/generated content)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/raw/README.md
!data/raw/olist/
data/raw/olist/*
!data/raw/olist/.gitkeep
!data/processed/.gitkeep
!data/processed/events/
data/processed/events/*
!data/processed/events/.gitkeep
# data/samples/ is intentionally NOT ignored — small, hand-authored
# fixtures and sample outputs are committed for tests and documentation.

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Docker
*.pid
