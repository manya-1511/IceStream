# Kafka bootstrap servers as seen from the HOST machine (this producer
# normally runs on the host, not inside the icestream-network container
# network — Kafka's HOST listener is exactly for this, see docker-compose.yml).
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# If running the producer *inside* the Docker network instead (e.g. as a
# future docker-compose service), override to: kafka:9092

CHECKOUT_EVENTS_TOPIC=checkout-events
CHECKOUT_EVENTS_DLQ_TOPIC=checkout-events.dlq
